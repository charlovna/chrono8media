---
import Layout from '../layouts/Layout.astro';
import MotionRoot from '../components/MotionRoot.astro';
import SectionNav from '../components/SectionNav.astro';
import Hero from '../components/Hero.astro';
import Expertise from '../components/Expertise.astro';
import PillarsStack from '../components/PillarsStack.astro';
import Testimonials from '../components/Testimonials.astro';
import Showcase from '../components/Showcase.astro';
import Process from '../components/Process.astro';
import WhyUs from '../components/WhyUs.astro';
import CompleteCTA from '../components/CompleteCTA.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <MotionRoot />
  <SectionNav />
  <main id="main-content">
    <Hero />
    <Expertise />
    <PillarsStack />
    <Testimonials />
    <Showcase />
    <Process />
    <WhyUs />
    <CompleteCTA />
  </main>
  <Footer />
</Layout>

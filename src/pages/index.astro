---
import Layout from '../layouts/Layout.astro';
import MotionRoot from '../components/MotionRoot.astro';
import StickyCTA from '../components/StickyCTA.astro';
import Hero from '../components/Hero.astro';
import TrustMarquee from '../components/TrustMarquee.astro';
import ProblemFrame from '../components/ProblemFrame.astro';
import PillarsStack from '../components/PillarsStack.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Testimonials from '../components/Testimonials.astro';
import Process from '../components/Process.astro';
import Qualifier from '../components/Qualifier.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <MotionRoot />
  <StickyCTA />
  <main id="main-content">
    <Hero />
    <TrustMarquee />
    <ProblemFrame />
    <PillarsStack />
    <CaseStudies />
    <Testimonials />
    <Process />
    <Qualifier />
    <FinalCTA />
  </main>
  <Footer />
</Layout>

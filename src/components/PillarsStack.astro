---
import { PILLARS } from '../data/content';
---
<!--
  §4 PILLARS - pinned crossfade (4 viewports of scroll inside one sticky viewport).
  Ported from prototype Chrono8 Media.html §4. The outer .pillars is 400vh; the
  inner .pillars-pin sticks at top and holds all 4 cards absolutely stacked on
  top of each other. scroll.ts initPillars() drives opacity crossfade per
  card and a 3D logo watermark scrub across the full range.
-->
<section
  id="sectionPillars"
  class="pillars"
  aria-label="Our four service pillars"
>
  <div id="pillarsPin" class="pillars-pin">
    {PILLARS.map((pillar, i) => (
      <article
        class={`pillar-card${i === 0 ? ' is-active' : ''}`}
        data-bg={pillar.bg}
        data-i={i}
      >
        <div class="pillar-num">{pillar.number}</div>

        <div class="pillar-body">
          <h3 class="pillar-name h-display">{pillar.name}</h3>
          <p class="pillar-tagline">{pillar.tagline}</p>
          <p class="pillar-desc">{pillar.body}</p>
        </div>

        <!-- 3D logo watermark: outer = positioning, inner div = transform target -->
        <div class="pillar-watermark" aria-hidden="true">
          <div><img src="/images/chrono8-logo.png" alt="" /></div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* Pin structure - count x 100vh tall so the pinned section gets `count`
     viewports of scroll progress (initPillars sets end: +=400%). */
  .pillars {
    position: relative;
    height: 400vh;
  }
  .pillars-pin {
    height: 100vh;
    width: 100%;
    overflow: hidden;
  }

  /* Cards absolutely stacked - opacity controlled by initPillars in scroll.ts */
  .pillar-card {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    transition: none; /* JS owns opacity */
  }
  .pillar-card.is-active { opacity: 1; }
  .pillar-card[data-bg="orange"] {
    background: var(--color-c8-orange);
    color: var(--color-c8-white);
  }
  .pillar-card[data-bg="black"] {
    background: var(--color-c8-black);
    color: var(--color-c8-white);
  }

  /* Card index (top corner) - alternates left/right across pillars */
  .pillar-num {
    position: absolute;
    top: 32px;
    left: 32px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.65;
    z-index: 3;
  }
  .pillar-card[data-i="1"] .pillar-num,
  .pillar-card[data-i="3"] .pillar-num {
    left: auto;
    right: 32px;
    text-align: right;
  }

  /* Card body - text content above the watermark.
     initPillars also writes translateY/scale here per scroll progress. */
  .pillar-body {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 720px;
    will-change: transform;
  }
  .pillar-name {
    font-size: clamp(3rem, 12vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin: 0 0 16px;
    color: var(--color-c8-white);
  }
  .pillar-tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(18px, 2.2vw, 24px);
    margin: 0 0 16px;
    opacity: 0.9;
  }
  .pillar-desc {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.55;
    max-width: 560px;
    margin: 0 auto;
    opacity: 0.8;
  }

  /* 3D watermark - full-viewport logo behind the body content.
     The inner <div> is the transform target driven by initPillars. */
  .pillar-watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
    perspective: 1200px;
    overflow: hidden;
  }
  .pillar-watermark > div {
    width: 70vmin;
    height: 70vmin;
    transform-style: preserve-3d;
    will-change: transform, filter;
  }
  .pillar-watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .pillar-card[data-bg="orange"] .pillar-watermark > div { opacity: 0.16; }
  .pillar-card[data-bg="black"]  .pillar-watermark > div { opacity: 0.22; }

  /* Reduced motion fallback - initPillars sets these styles inline too,
     but having a CSS guard prevents flash before JS boots. */
  @media (prefers-reduced-motion: reduce) {
    .pillars { height: auto; }
    .pillars-pin { height: auto; overflow: visible; }
    .pillar-card {
      position: relative;
      inset: auto;
      min-height: 100vh;
      opacity: 1;
    }
    .pillar-body { transform: none !important; }
    .pillar-watermark > div { transform: none !important; filter: none !important; }
  }
</style>

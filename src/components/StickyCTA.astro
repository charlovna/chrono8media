---
import { HERO } from '../data/content';
---
<!-- Appears after hero exits viewport; hides when Final CTA section is visible -->
<div
  id="sticky-cta"
  class="fixed bottom-6 right-6 z-50 opacity-0 translate-y-5 pointer-events-none transition-all duration-300"
>
  <a
    href={HERO.cta.href}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 bg-c8-black text-c8-white font-body font-bold rounded-full text-[14px] tracking-[0.02em] hover:bg-c8-grain transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-c8-orange"
    style="padding: 14px 24px;"
    aria-label='DM @chrono8media on Instagram — "GROW"'
  >
    DM "GROW" →
  </a>
</div>

<script>
  const sticky = document.getElementById('sticky-cta');
  const finalSection = document.getElementById('final-cta');

  function show() {
    sticky?.classList.remove('opacity-0', 'translate-y-5', 'pointer-events-none');
  }
  function hide() {
    sticky?.classList.add('opacity-0', 'translate-y-5', 'pointer-events-none');
  }

  // Hide when Final CTA is visible
  if (finalSection) {
    new IntersectionObserver(([e]) => e.isIntersecting ? hide() : (window.scrollY > window.innerHeight && show()), { threshold: 0.1 })
      .observe(finalSection);
  }

  // Show after scrolling past hero
  window.addEventListener('scroll', () => {
    if (window.scrollY > window.innerHeight) show(); else hide();
  }, { passive: true });
</script>

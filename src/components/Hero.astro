---
import Logo from './Logo.astro';
import { HERO } from '../data/content';

// Sub keyword wrapping: render any {{phrase}} in black on the orange hero.
function renderKeywords(text: string) {
  return text.split(/(\{\{[^}]+\}\})/g).map((chunk) => {
    const m = chunk.match(/^\{\{(.+)\}\}$/);
    return m ? `<span class="hero-key">${m[1]}</span>` : chunk;
  }).join('');
}
const subHTML = renderKeywords(HERO.sub);

const { line1, line2 } = HERO.headline;
---
<!--
  §1 HERO. Orange background. Prototype layout: flex-column, space-between.
  Five mechanically distinct entrance motions wired in motion/hero.ts:
    1. .hero-brand        letter-spacing expansion (tight to wide) + fade
    2. .line[data-tw="1"] GSAP TextPlugin typewriter, blinking caret
    3. .line[data-tw="2"] GSAP TextPlugin typewriter, caret continues, italic restored on complete
    4. .hero-sub          clip-path mask wipe (left to right curtain reveal)
    5. .hero-cta-wrap     smooth slide-up + scale settle (expo.out)
  Desktop: headline is full-width (left-aligned), 3D logo floats absolutely to the right.
  Mobile: headline full-width, 3D logo stacks below headline in flow.
-->
<section
  id="hero"
  data-section="hero"
  data-bg="orange"
  class="hero noise-overlay"
>
  <!-- Ghost logo centered behind the headline (prototype hallmark) -->
  <div class="hero-logo-ghost" aria-hidden="true">
    <Logo style="width: auto; height: min(96vh, 1100px); max-width: none;" opacity={0.08} />
  </div>

  <!-- All content inside a max-width shell that fills the full viewport height -->
  <div class="hero-inner">

    <!-- Top: brand eyebrow -->
    <div class="hero-top">
      <p class="hero-brand">
        {HERO.brand}
      </p>
    </div>

    <!-- Mid: headline takes full width; 3D logo is in-flow on mobile, absolute on desktop -->
    <div class="hero-mid">
      <div class="hero-headline-wrap">
        <h1 class="hero-headline h-display">
          <span class="line" data-tw="1">{line1}</span>
          <span class="line" data-tw="2">{line2}</span>
        </h1>
      </div>

      <!-- 3D floating logo: stacks below headline on mobile, floats right on desktop -->
      <div class="hero-logo-wrap">
        <Logo
          class="hero-logo-3d select-none pointer-events-auto"
          style="width: 100%; height: auto; will-change: transform;"
        />
      </div>
    </div>

    <!-- Bottom: sub text left, CTA right -->
    <div class="hero-bot">
      <p
        class="hero-sub"
        set:html={subHTML}
      />
      <div class="hero-cta-wrap">
        <a
          href={HERO.cta.targetId}
          class="hero-cta btn"
          aria-label={`${HERO.cta.label}. Jump to contact form.`}
          data-scroll-target={HERO.cta.targetId}
          data-magnetic
        >
          {HERO.cta.label}
          <span aria-hidden="true" class="arrow">→</span>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* Orange full-viewport hero */
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--color-c8-orange);
    color: var(--color-c8-white);
    overflow: hidden;
  }

  /* Ghost logo: absolutely behind everything */
  .hero-logo-ghost {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
    opacity: 0; /* motion/hero.ts fades to 0.08 */
  }

  /* Inner shell: flex column, fills full viewport height, gives top/mid/bottom structure */
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100svh;
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(20px, 4vw, 40px) clamp(24px, 5vw, 72px) clamp(40px, 6vw, 72px);
  }

  /* Top bar: brand eyebrow */
  .hero-top {
    display: flex;
    align-items: center;
  }

  .hero-brand {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.06em; /* Initial state: letter-spacing expansion motion */
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-c8-white) 90%, transparent);
    opacity: 0; /* motion/hero.ts animates to 1 */
    will-change: letter-spacing, opacity;
    margin: 0;
  }

  /* Mid: headline + floating logo.
     Mobile/tablet: column stack (logo below headline). Desktop 1024px+: logo absolute right. */
  .hero-mid {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    padding: 40px 0;
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero-mid {
      gap: 0; /* logo leaves flow; gap no longer needed */
    }
  }

  /* Headline wrapper: full width on mobile/tablet */
  .hero-headline-wrap {
    flex: 1;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    /* Reserve the right portion for the absolute logo so fitLine measures correctly */
    .hero-headline-wrap {
      padding-right: clamp(220px, 26vw, 360px);
    }
  }

  /* Headline typography - matches prototype font scale */
  .hero-headline {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -0.025em;
    font-stretch: condensed;
    word-spacing: 0.04em;
    --fit-scale: 1;
    font-size: calc(clamp(2.5rem, 11vw, 9rem) * var(--fit-scale));
    color: var(--color-c8-white);
    margin: 0;
  }

  .hero-headline > .line {
    display: block;
    white-space: nowrap;
    min-height: 0.92em; /* holds layout while typewriter canvas is empty */
    opacity: 0;          /* motion/hero.ts reveals once HTML is stashed */
  }

  /* Typewriter caret */
  .tw-caret {
    display: inline-block;
    width: 0.08em;
    height: 0.78em;
    background: currentColor;
    margin-left: 0.06em;
    vertical-align: -0.05em;
    animation: tw-blink 0.85s steps(1) infinite;
  }
  @keyframes tw-blink { 50% { opacity: 0; } }

  /* 3D logo: centered below headline on mobile/tablet, absolute right on desktop */
  .hero-logo-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    width: clamp(160px, 48vw, 260px);
    margin: 0 auto;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .hero-logo-wrap {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: clamp(220px, 26vw, 360px);
      margin: 0;
    }
  }

  /* Bottom: sub left, CTA right */
  .hero-bot {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .hero-bot {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
    }
  }

  /* Sub paragraph */
  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.55;
    max-width: 44ch;
    color: color-mix(in oklab, var(--color-c8-white) 92%, transparent);
    clip-path: inset(0 100% 0 0); /* Initial state for mask wipe animation */
    will-change: clip-path;
    margin: 0;
  }

  .hero-sub .hero-key {
    color: var(--color-c8-black);
    font-weight: 500;
  }

  /* CTA button: black pill. Initial state for slide-up animation. */
  .hero-cta-wrap {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    will-change: transform, opacity;
    flex-shrink: 0;
  }

  .hero-cta.btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-c8-black);
    color: var(--color-c8-white);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.02em;
    padding: 16px 28px;
    border-radius: 999px;
    transition: background 0.2s ease;
    will-change: transform;
    white-space: nowrap;
  }
  .hero-cta.btn:hover { background: #1a1a1a; }
  .hero-cta.btn:focus-visible {
    outline: 2px solid var(--color-c8-white);
    outline-offset: 4px;
  }
  .hero-cta .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .hero-cta:hover .arrow { transform: translateX(3px); }

  /* Reduced motion: skip all entrance animations, show final state */
  @media (prefers-reduced-motion: reduce) {
    .hero-brand,
    .hero-headline > .line,
    .hero-cta-wrap {
      opacity: 1 !important;
      letter-spacing: inherit;
      transform: none;
    }
    .hero-sub { clip-path: none; }
    .hero-logo-ghost { opacity: 0.08; }
    .tw-caret { display: none; }
  }
</style>

<script>
  /*
   * Hero local interactions only. Entrance choreography lives in motion/hero.ts.
   * fitLine for the 2-line headline is owned by motion/fit.ts.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isTouch = matchMedia('(pointer: coarse)').matches;

  // 3D logo: ambient float + cursor-tilt on desktop
  const logo = document.querySelector<HTMLElement>('.hero-logo-3d');
  if (logo && !reduced) {
    let t = 0;
    let raf = 0;
    function tick() {
      t += 0.016;
      const ry = Math.sin(t * 0.6) * 6;
      const rx = Math.cos(t * 0.4) * 3;
      const ty = Math.sin(t * 0.8) * 6;
      if (logo) logo.style.transform = `perspective(800px) translateY(${ty}px) rotateX(${rx}deg) rotateY(${ry}deg)`;
      raf = requestAnimationFrame(tick);
    }
    tick();

  }

  // CTA smooth-scroll via Lenis (falls back to native)
  document.querySelectorAll<HTMLAnchorElement>('[data-scroll-target]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const target = link.getAttribute('data-scroll-target');
      if (!target) return;
      const el = document.querySelector(target);
      if (!el) return;
      e.preventDefault();
      const lenis = (window as any).__c8Lenis;
      if (lenis && typeof lenis.scrollTo === 'function') {
        lenis.scrollTo(el, { offset: -16 });
      } else {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

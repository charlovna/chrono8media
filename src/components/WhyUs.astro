---
import { WHY_US } from '../data/content';

// Inline line-art SVGs (sourced from Lucide - kept inline so they
// render at zero JS cost and stay easy to style via currentColor).
const ICONS: Record<string, string> = {
  network: `
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="16" y="16" width="6" height="6" rx="1"/>
      <rect x="2"  y="16" width="6" height="6" rx="1"/>
      <rect x="9"  y="2"  width="6" height="6" rx="1"/>
      <path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/>
      <path d="M12 12V8"/>
    </svg>`,
  infinity: `
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z"/>
    </svg>`,
  trending: `
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
      <polyline points="16 7 22 7 22 13"/>
    </svg>`,
};
---
<section
  id="why-us"
  data-section="why-us"
  class="relative bg-c8-black text-c8-white py-24 sm:py-28 md:py-36"
  aria-label="Why Chrono8 Media stands above"
>
  <div class="mx-auto max-w-[1200px] px-6">
    <header class="max-w-[900px] mb-14 md:mb-20">
      <h2
        class="whyus-heading h-display text-c8-white"
        style="--fit-scale: 1; font-size: calc(clamp(2rem, 7vw, 4.5rem) * var(--fit-scale)); line-height: 1.04; letter-spacing: -0.025em;"
      >
        <span class="line">{WHY_US.heading.line1}</span>
        <span class="line">{WHY_US.heading.line2}</span>
      </h2>
    </header>

    <ul class="why-grid grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 list-none p-0 m-0">
      {WHY_US.cards.map((card) => (
        <li class="why-card card-glow flex flex-col items-center text-center p-8 md:p-10">
          <span
            class="why-icon flex items-center justify-center w-16 h-16 rounded-2xl mb-6 text-c8-orange"
            style="background: color-mix(in oklab, var(--color-c8-orange) 12%, transparent);"
            set:html={ICONS[card.icon] ?? ''}
          />
          <h3 class="font-display font-bold text-c8-white uppercase tracking-tight text-[18px] sm:text-[20px] md:text-[22px] mb-3">
            {card.title}
          </h3>
          <p class="font-body text-c8-white/75 text-[15px] sm:text-[16px] leading-relaxed max-w-[34ch]">
            {card.body}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

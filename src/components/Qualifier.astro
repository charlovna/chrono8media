---
import { QUALIFIER } from '../data/content';
---
<section
  id="qualifier"
  data-section="qualifier"
  class="relative min-h-screen"
  aria-label="Who we work with"
>
  <!-- Vertical bone-colored seam between the two columns -->
  <div
    class="absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2 hidden md:block"
    style="background: linear-gradient(to bottom, transparent 0%, #CFC2B4 20%, transparent 46%, transparent 54%, #CFC2B4 80%, transparent 100%);"
    aria-hidden="true"
  />

  <!-- Brand medallion at the seam center -->
  <div
    class="qualifier-medallion absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 hidden md:flex w-20 h-20 rounded-full items-center justify-center"
    style="background: #CFC2B4;"
    aria-hidden="true"
  >
    <img
      src="/images/chrono8-logo.png"
      alt=""
      style="width: 48px; height: auto; filter: brightness(0.3);"
    />
  </div>

  <div class="flex flex-col md:flex-row min-h-screen">

    <!-- Left block: BUILT FOR (orange) -->
    <div
      class="qualifier-built flex-1 bg-c8-orange flex items-center justify-center px-8 md:px-16 py-24 min-h-[70vh] md:min-h-screen"
    >
      <div class="max-w-sm w-full">
        <h2 class="h-display text-c8-white mb-10" style="font-size: clamp(2.5rem, 5vw, 5rem)">
          {QUALIFIER.built.heading}
        </h2>

        <ul class="space-y-6" role="list">
          {QUALIFIER.built.items.map((item, i) => (
            <li class="flex items-start gap-4">
              <span class="font-display text-[11px] text-c8-black/40 tracking-widest mt-1 shrink-0">
                0{i + 1}
              </span>
              <div class="border-t border-c8-black/20 pt-3 flex-1">
                <span class="font-body font-medium text-c8-white text-[20px] md:text-[22px] flex items-center gap-3">
                  <!-- Check icon -->
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {item}
                </span>
              </div>
            </li>
          ))}
        </ul>

        <p class="h-display text-c8-white mt-12" style="font-size: clamp(1.4rem, 2.5vw, 2rem)">
          {QUALIFIER.built.closing.preText}<br />
          <em>{QUALIFIER.built.closing.emphasis}</em>
        </p>
      </div>
    </div>

    <!-- Right block: NOT FOR (black) -->
    <div
      class="qualifier-not flex-1 bg-c8-black flex items-center justify-center px-8 md:px-16 py-24 min-h-[70vh] md:min-h-screen"
    >
      <div class="max-w-sm w-full">
        <h2 class="h-display text-c8-orange mb-10" style="font-size: clamp(2.5rem, 5vw, 5rem)">
          {QUALIFIER.not.heading}
        </h2>

        <ul class="space-y-6" role="list">
          {QUALIFIER.not.items.map((item, i) => (
            <li class="flex items-start gap-4">
              <span class="font-display text-[11px] text-c8-white/30 tracking-widest mt-1 shrink-0">
                0{i + 1}
              </span>
              <div class="border-t border-c8-white/20 pt-3 flex-1">
                <span class="font-body font-medium text-c8-white text-[20px] md:text-[22px] flex items-center gap-3">
                  <!-- X icon (orange) -->
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                    stroke="#FF5A1F" stroke-width="2.5" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                  {item}
                </span>
              </div>
            </li>
          ))}
        </ul>

        <p class="h-display text-c8-white mt-12" style="font-size: clamp(1.4rem, 2.5vw, 2rem)">
          {QUALIFIER.not.closing.preText}<br />
          <em class="text-c8-orange">{QUALIFIER.not.closing.emphasis}</em>
        </p>
      </div>
    </div>
  </div>
</section>

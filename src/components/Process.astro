---
import { PROCESS } from '../data/content';
const steps = PROCESS.steps;
---
<section
  id="process"
  data-section="process"
  class="relative bg-c8-black text-c8-white py-24 sm:py-28 md:py-36"
  aria-label="How our system works"
>
  <div class="mx-auto max-w-[1100px] px-6">
    <header class="max-w-[760px] mb-14 md:mb-20">
      <p class="font-body font-medium tracking-[0.18em] text-[12px] uppercase text-c8-orange mb-4">
        {PROCESS.eyebrow}
      </p>
      <h2
        class="section-heading h-display text-c8-white"
        data-fit
      >
        <span class="line">{PROCESS.heading.line1}</span>
        <span class="line">{PROCESS.heading.line2}</span>
      </h2>
    </header>

    <!-- Timeline track -->
    <ol class="timeline relative list-none p-0 m-0 flex flex-col gap-10 md:gap-16">
      <!-- Vertical spine: left-anchored on mobile, centered on md+ -->
      <span class="timeline-spine left-[19px] md:left-1/2 md:-translate-x-1/2" aria-hidden="true"/>

      {steps.map((step, i) => (
        <li
          class="timeline-step relative pl-14 md:pl-0"
          data-step={i}
        >
          <!-- Node dot anchored on the spine -->
          <span
            class="timeline-node absolute top-2 left-[12px] md:left-1/2 md:-translate-x-1/2 flex items-center justify-center w-4 h-4 rounded-full bg-c8-orange ring-4 ring-c8-black z-10"
            aria-hidden="true"
          />

          <!-- Card: full width on mobile; alternate L/R on md+ -->
          <article
            class:list={[
              'timeline-card card-glow p-6 md:p-8',
              'md:w-[calc(50%-40px)]',
              i % 2 === 0 ? 'md:mr-auto md:pr-10' : 'md:ml-auto md:pl-10',
            ]}
          >
            <span
              class="block font-display font-bold text-c8-orange leading-none mb-3"
              style="font-size: clamp(2.5rem, 7vw, 4rem);"
              aria-hidden="true"
            >
              {step.number}
            </span>
            <h3 class="font-display font-bold text-c8-white uppercase tracking-tight text-[20px] sm:text-[22px] md:text-[26px] mb-2">
              {step.title}
            </h3>
            <p class="font-body text-c8-white/80 text-[15px] sm:text-[16px] leading-relaxed max-w-[44ch]">
              {step.body}
            </p>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Scroll-progress filling of the timeline spine (set from JS).
     Falls back to no fill if JS is off / reduced motion. */
  .timeline { --spine-progress: 0%; }

  /* Card subtle reveal on enter — disabled under reduced motion */
  .timeline-card {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .timeline-step.is-visible .timeline-card {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const timeline = document.querySelector<HTMLElement>('.timeline');
  const steps = document.querySelectorAll<HTMLElement>('.timeline-step');

  if (timeline && steps.length) {
    // Reveal cards as they enter the viewport
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add('is-visible');
      }),
      { rootMargin: '0px 0px -10% 0px', threshold: 0.15 }
    );
    steps.forEach((s) => io.observe(s));

    if (!reduced) {
      // Fill the spine in sync with scroll progress through the timeline
      const update = () => {
        const r = timeline.getBoundingClientRect();
        const vh = window.innerHeight;
        const total = r.height + vh * 0.4;
        const past = Math.min(Math.max(vh * 0.6 - r.top, 0), total);
        const pct = Math.round((past / total) * 100);
        timeline.style.setProperty('--spine-progress', pct + '%');
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  }
</script>

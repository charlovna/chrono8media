---
import Logo from './Logo.astro';
import { FINAL_CTA } from '../data/content';
---
<section
  id="final-cta"
  data-section="final"
  class="relative bg-c8-orange min-h-[120vh] overflow-hidden noise-overlay"
>
  <!-- Ghost logo (parallax, centered) -->
  <div
    class="final-logo-ghost absolute inset-0 flex items-center justify-center pointer-events-none"
    aria-hidden="true"
  >
    <Logo opacity={0.10} style="width: 40vw; height: auto;" />
  </div>

  <!-- Top half: headline + CTA button -->
  <div class="relative z-10 min-h-[60vh] flex flex-col items-center justify-center text-center px-4 pt-24 pb-12">
    <h2 class="h-display text-c8-white mb-6" style="font-size: var(--text-h1)">
      <span class="line">{FINAL_CTA.headline.line1}</span>
      <span class="line"><em>{FINAL_CTA.headline.italicWord}</em> {FINAL_CTA.headline.line2}</span>
    </h2>

    <p class="font-body font-bold text-c8-white/80 text-[24px] mb-10">
      {FINAL_CTA.sub}
    </p>

    <a
      href={FINAL_CTA.cta.href}
      target="_blank"
      rel="noopener noreferrer"
      class="final-cta-btn inline-flex items-center gap-3 bg-c8-black text-c8-white font-body font-bold rounded-full text-[20px] tracking-[0.02em] transition-all duration-200 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-c8-white"
      style="padding: 24px 48px;"
      aria-label="DM @chrono8media on Instagram"
    >
      {FINAL_CTA.cta.label} →
    </a>
  </div>

  <!-- Bottom half: Behold Instagram feed -->
  <div id="behold-section" class="relative z-10 min-h-[60vh] px-4 pb-24">
    <div class="max-w-5xl mx-auto">
      <behold-widget feed-id={FINAL_CTA.behold.feedId}></behold-widget>
    </div>
    <!-- Static fallback if widget fails to load -->
    <p class="text-center mt-8 hidden" id="behold-fallback">
      <a
        href="https://instagram.com/chrono8media"
        target="_blank"
        rel="noopener noreferrer"
        class="font-body font-medium text-c8-white text-[18px] underline"
      >
        View our work on Instagram →
      </a>
    </p>
  </div>
</section>

<script>
  // Lazy-load Behold widget only when section scrolls into view
  const section = document.getElementById('behold-section');
  if (section) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        const script = document.createElement('script');
        script.src = 'https://w.behold.so/widget.js';
        script.type = 'module';
        script.onerror = () => {
          document.getElementById('behold-fallback')?.classList.remove('hidden');
        };
        document.head.appendChild(script);
        observer.disconnect();
      }
    }, { rootMargin: '200px' });
    observer.observe(section);
  }
</script>

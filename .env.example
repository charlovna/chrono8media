# ── Tina CMS Cloud (required for team to use /admin remotely) ──────────────────
# Get these from https://app.tina.io after creating a project.
# Leave empty to run in local-only mode (admin works at localhost only).
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=

# ── GitHub branch Tina commits content changes to ──────────────────────────────
GITHUB_BRANCH=main
